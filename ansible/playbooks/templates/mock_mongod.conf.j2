# -------------------------------------------------------------
# Simulated Production MongoDB Configuration File
# -------------------------------------------------------------
systemLog:
  destination: file
  logAppend: true
  path: {{ mongo_log_path }}/mongod.log

storage:
  dbPath: {{ mongo_db_path }}
  journal:
    enabled: true
  wiredTiger:
    engineConfig:
      cacheSizeGB: {{ wiredtiger_cache_gb }}

net:
  port: {{ mongo_port }}
  bindIp: {{ mongo_bind_ip }}

security:
  authorization: enabled
  keyFile: {{ mongo_keyfile_path }}

replication:
  replSetName: "{{ replica_set_name }}"

