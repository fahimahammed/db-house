#!/usr/bin/env bash
# ==============================================================================
# Script: mongodb_backup.sh
# Purpose: Enterprise automated & on-demand backup with oplog consistency,
#          SHA256 checksum validation, and automated retention cleanup.
# Managed by Ansible - Do NOT edit manually.
# ==============================================================================

set -euo pipefail

BACKUP_DIR="{{ backup_dir }}"
LOG_FILE="{{ backup_log_file }}"
RETENTION_DAYS="{{ backup_retention_days }}"
MONGO_PORT="{{ mongo_port }}"
ADMIN_USER="{{ mongo_admin_user }}"
ADMIN_PASS="{{ mongo_admin_password }}"
REPLSET_NAME="{{ mongo_replset_name }}"

TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
BACKUP_NAME="mongo_backup_${TIMESTAMP}"
ARCHIVE_PATH="${BACKUP_DIR}/${BACKUP_NAME}.archive.gz"
CHECKSUM_PATH="${ARCHIVE_PATH}.sha256"
META_PATH="${BACKUP_DIR}/${BACKUP_NAME}.json"

mkdir -p "${BACKUP_DIR}"
mkdir -p "$(dirname "${LOG_FILE}")"

log() {
  local msg="[$(date +'%Y-%m-%d %H:%M:%S')] $*"
  echo "$msg"
  echo "$msg" >> "${LOG_FILE}"
}

log "========================================================================"
log "STARTING MONGODB BACKUP: ${BACKUP_NAME}"
log "========================================================================"

# 1. Check if mongod is reachable
if ! mongosh --port "${MONGO_PORT}" -u "${ADMIN_USER}" -p "${ADMIN_PASS}" --authenticationDatabase admin --quiet --eval "db.adminCommand('ping')" >/dev/null 2>&1; then
  log "ERROR: mongod is not responding on port ${MONGO_PORT}. Aborting backup."
  exit 1
fi

# 2. Check node state (Prefer SECONDARY to prevent I/O spike on PRIMARY)
NODE_STATE=$(mongosh --port "${MONGO_PORT}" -u "${ADMIN_USER}" -p "${ADMIN_PASS}" --authenticationDatabase admin --quiet --eval "
  try {
    let s = rs.status();
    print(s.myState === 1 ? 'PRIMARY' : (s.myState === 2 ? 'SECONDARY' : 'OTHER'));
  } catch(e) {
    print('STANDALONE');
  }
")
log "Current Node Replica State: ${NODE_STATE}"

# 3. Execute mongodump with --oplog for point-in-time transactional consistency
START_TIME=$(date +%s)
log "Running mongodump with --oplog and gzip compression to: ${ARCHIVE_PATH}"

if mongodump \
  --host "127.0.0.1" \
  --port "${MONGO_PORT}" \
  -u "${ADMIN_USER}" \
  -p "${ADMIN_PASS}" \
  --authenticationDatabase admin \
  --oplog \
  --gzip \
  --archive="${ARCHIVE_PATH}" >> "${LOG_FILE}" 2>&1; then
  
  DURATION=$(( $(date +%s) - START_TIME ))
  FILE_SIZE=$(du -h "${ARCHIVE_PATH}" | awk '{print $1}')
  BYTES_SIZE=$(stat -c%s "${ARCHIVE_PATH}" 2>/dev/null || stat -f%z "${ARCHIVE_PATH}")
  
  log "Backup SUCCESSFUL! Size: ${FILE_SIZE} (${BYTES_SIZE} bytes) in ${DURATION}s"
else
  log "ERROR: mongodump failed! Check log file at ${LOG_FILE}"
  exit 1
fi

# 4. Generate SHA256 checksum for tamper-proofing and data integrity
log "Generating SHA-256 checksum: ${CHECKSUM_PATH}"
sha256sum "${ARCHIVE_PATH}" | awk '{print $1}' > "${CHECKSUM_PATH}"
CHECKSUM=$(cat "${CHECKSUM_PATH}")

# 5. Save metadata file
cat <<EOF > "${META_PATH}"
{
  "backup_name": "${BACKUP_NAME}",
  "timestamp": "${TIMESTAMP}",
  "replica_set": "${REPLSET_NAME}",
  "node_state": "${NODE_STATE}",
  "file_size_bytes": ${BYTES_SIZE},
  "file_size_human": "${FILE_SIZE}",
  "duration_seconds": ${DURATION},
  "sha256": "${CHECKSUM}",
  "oplog_included": true,
  "status": "COMPLETED"
}
EOF

# 6. Apply retention policy: prune backups older than RETENTION_DAYS
log "Enforcing retention policy: pruning backups older than ${RETENTION_DAYS} days..."
find "${BACKUP_DIR}" -type f \( -name "mongo_backup_*.archive.gz" -o -name "mongo_backup_*.sha256" -o -name "mongo_backup_*.json" \) -mtime "+${RETENTION_DAYS}" -exec rm -f {} +
log "Retention enforcement completed."

log "========================================================================"
log "BACKUP FINISHED: ${BACKUP_NAME}.archive.gz"
log "========================================================================"
exit 0

